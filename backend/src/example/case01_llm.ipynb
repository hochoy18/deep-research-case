    "from rich import print as rprint\n",
    "from src.agent.llm.llm import OpenAICompatibleLLM\n",
    "\n",
    "dotenv.load_dotenv(override=True)\n",
    "llm = OpenAICompatibleLLM(model_id='MiniMax-M3')\n",
